{
  "name": "shagritm",
  "version": "1.0.2",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "expo": "~56.0.16",
    "expo-camera": "~56.0.8",
    "expo-image-picker": "~56.0.21",
    "expo-sensors": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "phone:install": "expo run:android --device --port 8081",
    "phone:live": "powershell -ExecutionPolicy Bypass -File ./scripts/phone-live.ps1",
    "phone:rebuild": "expo run:android --device --variant debug --port 8081",
    "updates:configure": "npx eas-cli update:configure",
    "updates:validate": "node --experimental-strip-types scripts/validate-updates-config.ts",
    "preupdate:production": "npm run updates:validate && npm run typecheck && npm run test:unit",
    "update:production": "npx --yes eas-cli@24.0.0 update --channel production --environment production --platform android --non-interactive --input-dir .local-build/updates",
    "prebuild:android:production": "node --experimental-strip-types scripts/validate-updates-config.ts --native-build",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "backend:gemini": "node --experimental-strip-types server/gemini-backend.ts",
    "github:autosync": "powershell -ExecutionPolicy Bypass -File ./scripts/auto-github-sync.ps1",
    "github:autosync:install": "powershell -ExecutionPolicy Bypass -File ./scripts/auto-github-sync.ps1 -InstallTask",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:steps": "tsc --project tsconfig.tests.json && node --test .local-build/history-tests/tests/history-sync.test.js",
    "test:updates": "tsc --project tsconfig.tests.json && node --test .local-build/history-tests/tests/app-updates.test.js",
    "test:publication": "tsc --project tsconfig.tests.json && node --test .local-build/history-tests/tests/update-publication.test.js",
    "test:unit": "tsc --project tsconfig.tests.json && node --test .local-build/history-tests/tests/history-sync.test.js .local-build/history-tests/tests/app-updates.test.js .local-build/history-tests/tests/update-publication.test.js",
    "test:native": "powershell -ExecutionPolicy Bypass -File ./scripts/test-native-step-counter.ps1",
    "typecheck:backend": "tsc --project tsconfig.backend.json"
  },
  "private": true
}
