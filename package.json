{
  "name": "shagritm",
  "version": "1.0.1",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "expo": "~56.0.16",
    "expo-camera": "~56.0.8",
    "expo-image-picker": "~56.0.21",
    "expo-sensors": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "phone:install": "expo run:android --device --port 8081",
    "phone:live": "powershell -ExecutionPolicy Bypass -File ./scripts/phone-live.ps1",
    "phone:rebuild": "expo run:android --device --variant debug --port 8081",
    "updates:configure": "npx eas-cli update:configure",
    "preupdate:production": "node scripts/validate_updates_config.js",
    "update:production": "npx eas-cli update --channel production",
    "prebuild:android:production": "node scripts/validate_updates_config.js",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "backend:deepseek": "node --experimental-strip-types server/deepseek-backend.ts",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc --project tsconfig.backend.json"
  },
  "private": true
}
